# 关于进程管理命令
```bash
ps # 查看当前终端所有进程
ps -ef # 查看系统所有进程

pgrep -a sleep # 在系统进程中,查找命令名有sleep字段的所有进程,-a是显示详细信息
pgrep -f "sleep 100" # 在系统进程中,查找命令名字匹配完整字段"sleep 100",sleep 1000也会被匹配
pgrep -p PID # 查找PID对应的进程
pgrep -u lixiang # 查找关联用户为lixiang的所有进程
pkill sleep # 杀死pgrep sleep的结果
pkill -f "sleep 100" # 杀死pgrep -f "sleep 100"的结果

jobs # 查看当前终端后台运行的的任务
fg %1 # 将后台编号为1的任务拿到前台运行
bg %2 # 将后台编号为2的任务在后台继续运行
nohup 需要执行的命令 & # 执行命令,忽略当前终端的终止信号,当当前终端关闭时,还在后台继续运行
需要执行的命令 & # 将命令在后台运行

nice -n 18 需要执行的命令 # 执行命令,并设置nice值为18 
renice -n 18 -p PID # 给PID这个进程重新设置nice值
renice -n 18 -u lixiang # 把关联用户是lixiang的进程nice值设置为18

kill PID # 杀死PID这个进程
kill %1 # 杀死编号为1的后台任务
killall sleep # 杀死进程名字是sleep的所有进程
pkill sleep # 杀死pgrep sleep的显示结果

lsof # 列出系统全部打开的文件
lsof -i :8080 # 查看占用8080端口的进程
lsof -p PID # 查看PID进程打开的文件
lsof -u lixiang # 查看lixiang所有进程打开的文件
lsof test01.txt # 查看打开test01.txt文件的所有进程

kill $(lsof -t test01.txt) # 杀死所有打开test01.txt文件的进程,-t是terse精简模式
kill $(lsof -t -u lixiang test01.txt -a) # 杀死,用户lixiang打开test01.txt文件的进程,-a是and意思
kill $(lsof -i :8080) # 杀死占用:8080端口的进程

time 命令 # 查看命令运行消耗的时间
# 输出指标
real 从程序开始到程序结束的时间
user CPU处于用户态时间
sys CPU处于内核态时间

timeout 5 sleep 3 # 给程序设置最大运行时间,超时直接杀死

watch -n 2 命令 # 执行命令按照每2秒执行一次(默认是2秒)
watch 命令 # 每2秒执行一次后面的命令

systemctl cat ssh # 查看某一个服务实际使用配置
```
