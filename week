# 关于进程管理命令
```bash
ps # 查看当前终端的所有进程
ps -ef # 查看系统的所有进程
pgrep sleep # 查找系统进程中名字为sleep的进程
pgrep -p 进程的PID # 查找进程ID对应的进程
pgrep -a -u lixiang # 查找进程关联用户是lixiang的进程的详细信息
jobs # 查看当前终端的任务
fg %1 # 把当前终端任务编号为1的任务拿到前台运行
bg %1 # 把后台编号为1的任务在后天继续运行
nohup 命令 # 执行命令,忽略终端的终止信号
命令 & # 把命令在后台运行
nice -n 20 "命令" # 执行命令,并把命令的nice值设置为20
renice -n 20 -p 进程PID # 把进程PID的nice重新设置为20
renice -n 20 -u lixiang # 把关联用户为lixiang的进程的nice值设置为20

lsof # 列出系统全部打开的文件 (lsof,list open file)
lsof -i :8080 # 查看占用8080端口的进程
lsof -p PID # 查看该进程打开的所有文件
lsof -u lixiang # 查看lixiang所有进程打开的文件
lsof test01.txt # 查看占用文件的进程

kill $(lsof -t test01.txt) # 杀死所有打开test01.txt文件的进程
kill $(lsof -t -u lixiang test01.txt -a) # 杀掉,用户lixiang打开test01.txt文件的进程(-a是and的意思)
kill $(lsof -t -i :8080) # 杀死,占用8080端口的进程

time 命令 # 查看运行命令消耗的时间与系统资源
# 输出指标
real 从程序开始到程序结束的时间
user 你的程序在用户空间消耗CPU的时间
sys 你的程序调用操作系统内核功能,内核代码消耗CPU时间

timeout 5 sleep 3 # 给程序设置最大运行时间,超时直接杀死

watch -n 2 命令 # 执行命令按照每2秒执行一次(默认是2秒)

systemctl cat ssh # 查看某一个服务实际使用配置
```
